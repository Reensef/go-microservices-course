# Ссылка на подписку. Скачивается заново при каждом старте контейнера
XRAY_SUB_URL=https://example.com/connection/subs/<id>

# Индекс конфига в массиве подписки
XRAY_CONFIG_INDEX=1

# Порт HTTP-прокси внутри сети common
XRAY_HTTP_PORT=10809

# Проверка связи: адрес, интервал и число неудач подряд до перезапуска.
# Обрыв обнаруживается за INTERVAL * (RETRIES + 1), т.е. при 5 и 3 — за 20 секунд
XRAY_PROBE_URL=https://api.telegram.org
XRAY_PROBE_INTERVAL=5
XRAY_PROBE_RETRIES=3
