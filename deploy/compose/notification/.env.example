LOGGER_LEVEL=info
LOGGER_AS_JSON=true

OTEL_SERVICE_NAME=notification-service
OTEL_ENVIRONMENT=dev

KAFKA_HOST=kafka
KAFKA_PORT=29092

CONSUMER_GROUP_ID=notification-service
ORDER_PAID_TOPIC_NAME=order-paid-events
SHIP_ASSEMBLED_TOPIC_NAME=ship-assembled-events

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Доступ к Telegram API только через xray-прокси в сети common.
# NO_PROXY нужен, чтобы OTLP-экспортер (grpc-go читает эти переменные)
# ходил в otel-collector напрямую, а не через прокси
HTTPS_PROXY=http://xray:10809
HTTP_PROXY=http://xray:10809
NO_PROXY=localhost,127.0.0.1,kafka,otel-collector
